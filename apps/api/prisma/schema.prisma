// Prisma schema para ticketera.
// Provider: PostgreSQL (Neon). Datasource: env("DATABASE_URL") (pooled, connection_limit=1).
// NO ejecutar `prisma migrate` aún: el usuario debe aprobar. El archivo es válido para `prisma generate`.
//
// Notas de diseño:
//  - Los modelos Account/Session/VerificationToken/User siguen la forma esperada por
//    @auth/prisma-adapter (Auth.js v5). El nombre del modelo User debe ser exactamente "User".
//  - Los enums Role, TicketState, Priority y TicketType son la fuente de verdad del dominio
//    y deben coincidir 1:1 con packages/types.
//  - reporterId/assigneeId usan relaciones con nombre para evitar colisión de campos FK.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  agente
  usuario
}

enum TicketState {
  abierto
  en_progreso
  en_revision
  resuelto
  cerrado
  reabierto
}

enum Priority {
  baja
  media
  alta
  urgente
}

enum TicketType {
  bug
  feature
  tarea
  epic
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @default(usuario)
  createdAt DateTime @default(now())

  accounts Account[]
  sessions Session[]

  // Relaciones de dominio (nombre explícito para diferenciar reporter/assignee)
  reportedTickets Ticket[]      @relation("ReportedTickets")
  assignedTickets Ticket[]      @relation("AssignedTickets")
  projectMembers  ProjectMember[]
  comments        Comment[]
  attachments     Attachment[]
  histories       TicketHistory[]
  notifications   Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  key         String   @unique // p.ej. SUP
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())

  members  ProjectMember[]
  tickets  Ticket[]
  labels   Label[]

  @@index([createdById])
}

model ProjectMember {
  id            String       @id @default(cuid())
  projectId     String
  userId        String
  roleInProject Role         @default(usuario)
  joinedAt      DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Ticket {
  id          String      @id @default(cuid())
  projectId   String
  number      Int // correlativo por proyecto; la clave visible es `${Project.key}-${number}`
  key         String // derivado, p.ej. SUP-12
  title       String
  description String?
  state       TicketState @default(abierto)
  priority    Priority    @default(media)
  type        TicketType  @default(tarea)
  reporterId  String
  assigneeId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter  User           @relation("ReportedTickets", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee  User?          @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments  Comment[]
  histories TicketHistory[]
  labels    TicketLabel[]
  attachments Attachment[]

  @@unique([projectId, number])
  @@unique([key])
  @@index([state])
  @@index([assigneeId])
  @@index([reporterId])
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Label {
  id        String   @id @default(cuid())
  projectId String
  name      String
  color     String?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets TicketLabel[]

  @@unique([projectId, name])
}

model TicketLabel {
  ticketId String
  labelId  String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([ticketId, labelId])
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String
  uploadedById String
  filename     String
  url          String
  size         Int?
  mimeType     String?
  createdAt    DateTime @default(now())

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy  User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketHistory {
  id        String      @id @default(cuid())
  ticketId  String
  actorId   String
  fromState TicketState
  toState   TicketState
  createdAt DateTime    @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([actorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
