# Variables de entorno del Web (Next.js). NO commitear; copiar a apps/web/.env.local
# para desarrollo y configurar en Vercel (proyecto ticketera-sigma) en producción.

# URL absoluta del API (proyecto Vercel ticketera-api). Usada por el proxy server-side.
NEXT_PUBLIC_API_URL=https://ticketera-api.vercel.app

# URL canónica del sitio (Auth.js v5 requiere AUTH_URL en producción).
AUTH_URL=https://ticketera-sigma.vercel.app

# Mismo secreto que el API (AUTH_SECRET) para verificar el JWT de sesión en el proxy.
AUTH_SECRET=84lk0gMpRg90POWjsfJf2jVIXWZrrWcGMnwWi+6z/4o=

# GitHub OAuth (Auth.js). En prod el callback es https://ticketera-sigma.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=Ov23lidKc8LZfCjrGtlQ
AUTH_GITHUB_SECRET=4e1ef369c89adc8f95b07ee419b927e640913001
